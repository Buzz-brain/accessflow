{
  "expo": {
    "name": "AccessFlow",
    "slug": "accessflow-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "accessflow",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.accessflow.mobile"
    },
    "android": {
      "package": "com.accessflow.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#087F5B"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#087F5B"
    },
    "icon": "./assets/icon.png",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "accessflow-mobile-local"
      }
    }
  }
}
