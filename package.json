{
  "name": "accessflow-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for a multidimensional accessibility model for enhancing mobile banking usability among visually impaired users",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seeders/seed.js",
    "migrate:money": "node scripts/migrate-money-to-kobo.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand src/tests/unit",
    "test:integration": "jest --runInBand src/tests/integration",
    "lint": "node scripts/lint.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/src/tests/setup.js"
    ],
    "testTimeout": 120000,
    "verbose": false
  }
}
